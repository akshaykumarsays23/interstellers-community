# ==========================================
# INTERSTELLERS ENVIRONMENT CONFIGURATION
# ==========================================

# --- AI ASSISTANT (NOVA AI) ---
# Configure at least ONE of the following AI providers:
# GEMINI_API_KEY is read only by the server-side /api/ai/chat route; never prefix it with NEXT_PUBLIC_.
# On Vercel, add it under Project Settings > Environment Variables and redeploy.

# 1. Google Gemini (Recommended - Fast & Free tier available at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. OpenAI (Optional alternative - https://platform.openai.com/)
# OPENAI_API_KEY=your_openai_api_key_here

# 3. Groq (Optional alternative - Ultra-fast inference at https://console.groq.com/)
# GROQ_API_KEY=your_groq_api_key_here

# --- WEB SEARCH (OPTIONAL) ---
# If you want Nova to perform live internet searches for current news:
# Tavily Search API (https://tavily.com/)
# TAVILY_API_KEY=your_tavily_api_key_here
# OR Serper Google Search (https://serper.dev/)
# SERPER_API_KEY=your_serper_api_key_here

# --- GMAIL DISPATCHER ---
GMAIL_USER=akshaycricketer1230@gmail.com
GMAIL_APP_PASSWORD=your_16_character_gmail_app_password

# --- AUTHENTICATION & SECURITY (OPTIONAL) ---
# Secret used to sign HMAC-SHA256 OTP tokens and session cookies
# Generate any random 32+ character string
AUTH_SECRET=your_random_auth_secret_key_here
