# ==========================================
# INTERSTELLERS ENVIRONMENT CONFIGURATION
# ==========================================

# --- DATABASE ---
# Required Neon PostgreSQL connection used by the server. Preserve the connection settings
# from your Neon connection string, including SSL options.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# --- AUTHENTICATION ---
# Required for OTP and session token signing/verification. Use a private random value of 32+ characters.
AUTH_SECRET=replace_with_a_private_random_secret_at_least_32_characters

# --- ANANT ASSISTANT ---
# Configure at least ONE of the following AI providers:
# Provider keys are read only by the server-side /api/ai/chat route; never prefix them with NEXT_PUBLIC_.
# On Vercel, add it under Project Settings > Environment Variables and redeploy.

# OpenAI is the default provider. OPENAI_MODEL is an optional model override.
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=your_openai_model

# Google Gemini is used if OpenAI is unavailable or has a temporary failure.
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=your_gemini_model

# Groq is selected for lightweight requests when configured.
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=your_groq_model

# --- WEB SEARCH (OPTIONAL) ---
# Configure either or both providers for current-information searches.
# Tavily Search API (https://tavily.com/)
# TAVILY_API_KEY=your_tavily_api_key_here
# OR Serper Google Search (https://serper.dev/)
# SERPER_API_KEY=your_serper_api_key_here

# --- GMAIL DISPATCHER ---
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_16_character_gmail_app_password

# PIN required to access the Space Stations tab (server-side only)
STATIONS_PIN_CODE=your_six_digit_pin
